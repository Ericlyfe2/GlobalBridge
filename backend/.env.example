NODE_ENV=development
PORT=4000

# Database (optional — only used by domain routes still on Postgres)
# DATABASE_URL=postgresql://globalbridge:globalbridge_dev@localhost:5432/globalbridge

# Firebase Admin (from your service-account JSON)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_WITH_ESCAPED_NEWLINES\n-----END PRIVATE KEY-----\n"

# AI Service

# OpenAI API Key (for RAG embeddings on the backend)
# OPENAI_API_KEY=sk-your-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# File uploads (local disk directory — replace with S3/Cloudinary for production)
# UPLOAD_DIR=./uploads

# CORS
CORS_ORIGIN=http://localhost:3000

# Third-party (optional for dev)
GOOGLE_TRANSLATE_API_KEY=
STRIPE_SECRET_KEY=
PAYSTACK_SECRET_KEY=
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
CLOUDINARY_URL=
AWS_S3_BUCKET=

# ── File storage (GB-10) ──────────────────────────────────────────────────────
# Uploads MUST go to durable object storage. The container filesystem is
# ephemeral (Dockerfile on Railway, no VOLUME), so local disk loses every
# verification document on each deploy. With NODE_ENV=production and no
# S3_BUCKET set, the API refuses to start rather than accept files it will lose.
#
# Any S3-compatible provider works — AWS S3, Cloudflare R2, Backblaze B2, MinIO.
# Set S3_ENDPOINT for anything other than AWS.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
#
# Escape hatch for a deliberately disposable environment (a preview deploy, a
# demo). Never set this where real users upload identity documents.
# STORAGE_ALLOW_EPHEMERAL=1

# ── Reverse-proxy depth (GB-13) ───────────────────────────────────────────────
# How many proxy hops to trust when deriving the client IP for rate limiting.
# Express trusts none by default, which behind a platform load balancer put every
# user into one shared bucket. Defaults to 1 in production, 0 in development.
# Raise it only if you add another proxy (a CDN) in front. Never use `true`:
# X-Forwarded-For is client-writable, so trusting the whole chain lets anyone
# mint a fresh bucket per request.
# TRUST_PROXY_HOPS=1
