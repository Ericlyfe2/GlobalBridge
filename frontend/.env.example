# Backend API URL — required for register-profile + me.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Firebase client config (Project settings → Your apps → SDK setup)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ── AI provider: Google Gemini ───────────────────────────────────────────────
# Required for every /api/ai/* route. Without it isAiConfigured() is false and
# the AI tools return their clearly-labelled offline state instead of an answer.
#
# This file previously documented OPENAI_API_KEY / OPENAI_MODEL=gpt-4o here.
# Nothing in frontend/src reads any OPENAI_* variable — the routes run on
# @ai-sdk/google — so following the old instructions produced a working-looking
# setup with a silently dead AI. Removed rather than left as a trap.
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# Also accepted as a fallback name by lib/ai-client.ts:
# GEMINI_API_KEY=your-gemini-api-key
# Optional model override. Default is gemini-2.5-flash; unknown or legacy names
# are normalised to a supported model rather than sent to the provider as-is.
# GEMINI_MODEL=gemini-2.5-flash

# NOTE: backend RAG embeddings still use OpenAI, configured in backend/.env
# (OPENAI_API_KEY there). That is a separate service from the chat routes above.

# NOT USED — no Upstash client exists in frontend/src. Rate limiting lives in
# the Express backend (ioredis, see backend/src/lib/rate-limit-store.ts), and
# falls back to an in-process store when Redis is absent.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Public site URL for SEO hreflang + sitemap
NEXT_PUBLIC_SITE_URL=https://globalbridge.app
